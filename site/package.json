{
  "name": "threadboard-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && npm run check",
    "dev": "node scripts/dev.mjs",
    "test": "playwright test --config playwright.config.ts",
    "graphics": "npm run build && node scripts/render-share.mjs && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@playwright/test": "^1.63.0"
  }
}
